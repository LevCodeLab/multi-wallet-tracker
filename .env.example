# Default public EVM chain ID (1 = Ethereum, 8453 = Base, 42161 = Arbitrum One)
VITE_DEFAULT_CHAIN_ID=8453

# Optional custom primary RPC URL (leaves public failover pool active as backup)
VITE_CUSTOM_RPC_URL=

# Optional default ERC-20 token contract to watch alongside native ETH
VITE_DEFAULT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Default treasury / destination address for gas sweep calculations
VITE_TREASURY_SWEEP_ADDRESS=0x0000000000000000000000000000000000000000
